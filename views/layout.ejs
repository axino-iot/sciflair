<!DOCTYPE html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <% var pageTitle = (typeof title !== 'undefined' && title) ? title : 'Embedded Systems and IoT Design, Bristol UK | SciFlair'; %>
    <% var pageDesc = (typeof description !== 'undefined' && description) ? description : 'SciFlair designs embedded electronics, firmware and cloud software for connected products, from first prototype to production and support. Bristol, UK.';
       var path = (typeof currentPath === 'string') ? currentPath : '/';
       var pageUrl = 'https://www.sciflair.com' + path;
       var pageImg = 'https://www.sciflair.com' + ((typeof ogImage !== 'undefined' && ogImage) ? ogImage : '/images/og-sciflair.jpg'); %>
    <meta name="description" content="<%= pageDesc %>" />
    <meta name="author" content="SciFlair Ltd" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="theme-color" content="#1E2836" />
    <title><%= pageTitle %></title>
    <link rel="canonical" href="<%= pageUrl %>" />
    <!-- Social sharing (LinkedIn, WhatsApp, email previews) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SciFlair" />
    <meta property="og:title" content="<%= pageTitle %>" />
    <meta property="og:description" content="<%= pageDesc %>" />
    <meta property="og:url" content="<%= pageUrl %>" />
    <meta property="og:image" content="<%= pageImg %>" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="<%= pageTitle %>" />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <!-- Self-hosted brand fonts: Montserrat (headings), Lato (body) -->
    <link rel="preload" href="/fonts/montserrat-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/lato-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/css/site.css" />
    <!-- Organisation details for search engines -->
    <script type="application/ld+json">
    {"@context":"https://schema.org","@type":"ProfessionalService","@id":"https://www.sciflair.com/#org","name":"SciFlair Ltd","alternateName":"SciFlair","url":"https://www.sciflair.com","logo":"https://www.sciflair.com/images/sciflair-logo-600.png","image":"https://www.sciflair.com/images/og-sciflair.jpg","description":"Embedded electronics, firmware, cloud and IoT systems design, prototyping and support.","email":"info@sciflair.com","telephone":"+44 117 313 7585","foundingDate":"2014","founder":{"@type":"Person","name":"Dr M Fahim Tariq"},"address":{"@type":"PostalAddress","streetAddress":"Unit 18, Apex Court, Woodlands","addressLocality":"Bradley Stoke, Bristol","postalCode":"BS32 4JT","addressCountry":"GB"},"areaServed":"GB","knowsAbout":["Embedded systems","PCB design","Firmware","Internet of Things","Machine vision","Video management software","Systems engineering"],"sameAs":["https://www.linkedin.com/company/sciflair-limited/"]}
    </script>
    <% if (typeof jsonld !== 'undefined' && jsonld) { %><script type="application/ld+json"><%- JSON.stringify(jsonld) %></script><% } %>
  </head>
  <body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
    <a class="skip" href="#main">Skip to content</a>
    <%- include('partials/header') %>
    <main id="main">
      <%- body %>
    </main>
    <%- include('partials/footer') %>
    <script>
      (function () {
        var header = document.getElementById('site-header');
        var btn = document.getElementById('nav-toggle');
        var nav = document.getElementById('site-nav');
        if (btn && nav) {
          btn.addEventListener('click', function () {
            var open = nav.classList.toggle('is-open');
            btn.setAttribute('aria-expanded', open ? 'true' : 'false');
          });
          nav.addEventListener('click', function (e) {
            if (e.target.tagName === 'A') { nav.classList.remove('is-open'); btn.setAttribute('aria-expanded', 'false'); }
          });
        }
        function onScroll() { if (header) header.classList.toggle('is-scrolled', window.pageYOffset > 40); }
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      })();
    </script>
  </body>
</html>
