<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <% var pageTitle = (typeof title !== 'undefined' && title) ? title : 'SciFlair | Connected Systems Engineering – IoT, Energy, Video & AI | Bristol, UK'; %>
    <% var pageDesc = 'SciFlair designs and builds connected systems – hardware, embedded firmware, cloud platforms and apps – for energy, water, video and security, smart city and AgriTech. Based in Bristol, UK.'; %>
    <meta name="description" content="<%= pageDesc %>" />
    <meta name="keywords" content="IoT, connected systems, embedded systems, energy management, smart water metering, video management software, CCTV, GPS fleet tracking, LoRa, machine vision, AgriTech, Bristol">
    <meta name="author" content="SciFlair Ltd" />
    <title><%= pageTitle %></title>
    <link rel="canonical" href="https://www.sciflair.com/" />
    <!-- Social sharing (LinkedIn, WhatsApp, email previews) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SciFlair" />
    <meta property="og:title" content="<%= pageTitle %>" />
    <meta property="og:description" content="<%= pageDesc %>" />
    <meta property="og:url" content="https://www.sciflair.com/" />
    <meta property="og:image" content="https://www.sciflair.com/images/og-sciflair.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Favicon-->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <!-- Google fonts-->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&display=swap" rel="stylesheet">
    <!-- Organisation details for search engines -->
    <script type="application/ld+json">
    {"@context":"https://schema.org","@type":"Organization","name":"SciFlair Ltd","url":"https://www.sciflair.com","logo":"https://www.sciflair.com/images/sciflair.svg","email":"info@sciflair.com","telephone":"+44 117 313 7585","foundingDate":"2014","address":{"@type":"PostalAddress","streetAddress":"Unit 18, Apex Court, Woodlands","addressLocality":"Bradley Stoke, Bristol","postalCode":"BS32 4JT","addressCountry":"GB"},"sameAs":["https://www.linkedin.com/company/sciflair-limited/","https://www.axino.co/","https://itrack.uk/"]}
    </script>
    <!-- Font Awesome icons -->
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.6.3/css/all.css" integrity="sha384-UHRtZLI+pbxtHCWp1t77Bi1L4ZtiqrqD80Kn4Z8NTSRyMA2Fd33n5dQ8lWUE00s/" crossorigin="anonymous">
    <!-- <link href="//maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css" media="all" rel="stylesheet" type="text/css"> -->
    <!-- Core theme CSS (includes Bootstrap)-->
    <link href="/css/styles.css" rel="stylesheet" />
  </head>
  <body id="page-top">
    <%- body %>

    <script>

        var section; // = document.querySelectorAll(".section");
        var sections = {};
        var i = 0;

        window.onload = function (){
          //scroll spy on sections
          // section = document.querySelectorAll("section");
          // Array.prototype.forEach.call(section, function(e) {
          //   sections[e.id] = e.offsetTop;
          // });


          //menu toggeler
          let el = document.getElementById('btn-menu-tgl');
          if(el)
          {
            el.addEventListener('click', (e) =>{
              let el2 = document.getElementById('navbarMenu');
              el2.classList.toggle("collapse");
              if(el2.classList.contains('collapse'))
                el.setAttribute('aria-expanded', 'false');
              else
                el.setAttribute('aria-expanded', 'true');
            });
          }  
        }



        window.onscroll = function() {
          //scrollspy  
          // let sypos = document.documentElement.scrollTop || document.body.scrollTop;
          // for (i in sections) {
          //   if (sypos > sections[i] - 10) {
          //     let el = document.getElementById('navbarMenu').querySelectorAll("a.nav-link");
          //     el.forEach(itm =>{
          //       itm.classList.remove('active');
          //     });
          //     document.querySelector('a[href*=' + i + ']').classList.add('active');
          //   }
          // }
          //change header on scroll down
          let el = document.getElementById('mainNav');
          if(el)
          {
            let sypos = window.pageYOffset;
            if(sypos > 100)
            {
              el.classList.add('navbar-scrolled'); 
            }
            else el.classList.remove('navbar-scrolled');
          }
        }

      </script>
  </body>
</html>
