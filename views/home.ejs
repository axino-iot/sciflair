<%
function ph(label, cls) {
  // Placeholder until Fahim's project photos arrive
  return '<div class="ph ' + (cls || '') + '" role="img" aria-label="' + label + '"><span>Photo: ' + label + '</span></div>';
}
%>

<!-- 1. Hero -->
<section class="hero">
  <div class="hero-media hero-pcb" aria-hidden="true"><%- include('partials/hero-pcb') %></div>
  <div class="wrap hero-content">
    <p class="eyebrow">SciFlair · Bristol, UK</p>
    <h1>Connected Systems Engineering</h1>
    <p class="hero-sectors">IoT · AI · Energy · Video · Automation</p>
    <p class="hero-lede">Electronics, embedded firmware, cloud platforms and apps – from a first prototype to products running for years in the field.</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="#services">See What We Do and How</a>
    </div>
  </div>
</section>

<!-- 2. Proof strip -->
<section class="proof" aria-label="SciFlair in numbers">
  <div class="wrap proof-grid">
    <% site.proof.forEach(function (p) { %>
      <div class="proof-item">
        <span class="proof-value"><%= p.value %></span>
        <span class="proof-label"><%= p.label %></span>
      </div>
    <% }) %>
  </div>
</section>

<!-- 2b. Routes for each audience -->
<section class="routes" aria-label="Work with SciFlair">
  <div class="wrap routes-grid">
    <% site.audiences.forEach(function (a) { %>
      <a class="route" href="<%= a.href %>">
        <span class="route-who"><%= a.who %></span>
        <h2 class="route-title"><%= a.title %></h2>
        <p><%= a.text %></p>
        <span class="route-cta"><%= a.cta %> <%- include('partials/icon', { name: 'arrow' }) %></span>
      </a>
    <% }) %>
  </div>
</section>

<!-- 3. Design services -->
<section class="section" id="services">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">What We Do</p>
      <h2>What We Can Design for You</h2>
      <p>We design embedded systems end to end: the electronics, the firmware and the software around them. Bring us an idea, a half-finished design or a problem in the field, and we take it to a working prototype or a finished product.</p>
    </div>
    <div class="svc-grid">
      <% site.services.forEach(function (s) { %>
        <div class="svc">
          <span class="svc-icon"><%- include('partials/icon', { name: s.icon }) %></span>
          <h3><%= s.title %></h3>
          <p><%= s.text %></p>
          <a class="svc-proof" href="<%= s.proof.href %>">See it in: <%= s.proof.label %> <%- include('partials/icon', { name: 'arrow' }) %></a>
        </div>
      <% }) %>
    </div>
    <div class="svc-cta">
      <p>Have a design brief, a sketch or just a problem to solve?</p>
      <a class="btn btn-primary btn-lg" href="#contact">Send Us Your Brief <%- include('partials/icon', { name: 'arrow' }) %></a>
    </div>
  </div>
</section>

<!-- 3b. How we work with you -->
<section class="section section-grey" id="engage">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">How We Work</p>
      <h2>How We Work With You</h2>
      <p>Five clear steps from first conversation to products in the field. Each one ends with something you can use, so you can stop, pause or carry on with full knowledge of cost and risk.</p>
    </div>
    <ol class="eng">
      <% site.engagements.forEach(function (e, i) { %>
        <li class="eng-step">
          <span class="eng-num"><%= i + 1 %></span>
          <h3><%= e.title %></h3>
          <p><%= e.text %></p>
          <p class="eng-get"><span>You get</span><%= e.get %></p>
        </li>
      <% }) %>
    </ol>
    <ul class="eng-promises">
      <% site.promises.forEach(function (x) { %><li><%= x %></li><% }) %>
    </ul>
  </div>
</section>

<!-- 5. How we work -->
<section class="section section-navy">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">How We Deliver</p>
      <h2>The Whole System Life Cycle, Under One Roof</h2>
      <p>We follow INCOSE systems engineering practice (ISO/IEC/IEEE 15288) and run projects in PRINCE2 management stages, so every stage ends at a decision gate where you review progress, risk and the business case before committing to the next.</p>
    </div>
    <ol class="steps">
      <% site.steps.forEach(function (st, i) { %>
        <li class="step">
          <span class="step-num"><%= ('0' + (i + 1)) %></span>
          <h3><%= st.title %></h3>
          <p><%= st.text %></p>
        </li>
      <% }) %>
    </ol>
  </div>
</section>

<!-- 4. Our products (first focus) -->
<section class="section" id="products">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Our Products</p>
      <h2>Platforms We Own, Built Once and Reused</h2>
      <p>Hardware and software we designed, own and deploy across our projects, ready to scale with investors and partners.</p>
    </div>
    <div class="project-grid grid-4">
      <% site.byType('product').forEach(function (p) { %><%- include('partials/card', { p: p, site: site }) %><% }) %>
    </div>
    <div class="center">
      <a class="btn btn-dark" href="/products">See All Products <%- include('partials/icon', { name: 'arrow' }) %></a>
    </div>
  </div>
</section>

<!-- 7. Research & leadership -->
<section class="section section-grey" id="research">
  <div class="wrap founder">
    <div class="founder-photo"><img src="/images/company/founder-600.webp" alt="Dr M Fahim Tariq, Founder and Director of SciFlair" width="600" height="600" loading="lazy" /></div>
    <div class="founder-body">
      <p class="eyebrow">Research &amp; Leadership</p>
      <h2>Led by an Engineer</h2>
      <p class="founder-name">Dr M Fahim Tariq, Founder &amp; Director</p>
      <p>Fahim founded SciFlair in 2014 and has led engineering programmes for more than 25 years, including a £10M+ command-and-control vehicle programme at XAD Communications. He holds a PhD in adaptive modem design from the University of Bristol.</p>
      <p>SciFlair works with a UK-led team of up to 17 engineers, including remote specialists, scaled to each project and run from our own office and research lab in Bristol, with systems delivered in the UK, Europe, the Middle East and South Asia. Electronics, firmware, cloud and apps are designed together, so every system works as one.</p>
      <ul class="facts">
        <li><strong>17</strong> publications (15 peer-reviewed), 380+ citations</li>
        <li><strong>2</strong> UWE PhDs co-funded and mentored, completed 2026</li>
        <li><strong>KTP</strong> partnership on cloud video analytics</li>
        <li><strong>Own</strong> office and research lab in Bristol</li>
        <li><strong>22</strong> engineers built up at XAD, funded by contract revenue</li>
        <li><strong>2016+</strong> SciFlair service and support of the command-and-control fleet</li>
      </ul>
      <a class="btn btn-dark" href="https://www.linkedin.com/company/sciflair-limited/"><%- include('partials/icon', { name: 'linkedin' }) %> Connect on LinkedIn</a>
    </div>
  </div>
  <div class="wrap base">
    <h3 class="base-title">Our Bristol Office and Lab</h3>
    <div class="base-grid">
      <figure class="base-main"><img src="/images/company/entrance-900.webp" alt="Entrance to Unit 18, Apex Court, Bradley Stoke, Bristol" width="900" height="1200" loading="lazy" /><figcaption>Our office in Bradley Stoke, Bristol</figcaption></figure>
      <figure><img src="/images/company/lab-800.webp" alt="Electronics workbench with component storage and test equipment" width="800" height="600" loading="lazy" /><figcaption>Electronics lab</figcaption></figure>
      <figure><img src="/images/company/equipment-store-800.webp" alt="Rugged portable camera and communication kits" width="800" height="600" loading="lazy" /><figcaption>Portable kits</figcaption></figure>
      <figure><img src="/images/company/office-800.webp" alt="Desks in the SciFlair engineering office" width="800" height="600" loading="lazy" /><figcaption>Engineering office</figcaption></figure>
    </div>
  </div>
</section>

<!-- 8. Contact -->
<section class="section section-navy" id="contact">
  <div class="wrap contact">
    <div class="contact-info">
      <p class="eyebrow">Contact</p>
      <h2>How Can We Help?</h2>
    </div>
    <form class="contact-form" method="post" action="/contact">
      <% if (contactStatus === 'invalid') { %>
        <p class="form-msg form-msg--warn" role="alert">Please add your name, a valid email address and a message.</p>
      <% } else if (contactStatus === 'not-connected') { %>
        <p class="form-msg form-msg--warn" role="alert">Thank you. Our form is being connected – please also email <a href="mailto:info@sciflair.com">info@sciflair.com</a> so we don't miss you.</p>
      <% } else if (contactStatus === 'sent') { %>
        <p class="form-msg" role="status">Thank you – we'll be in touch within one working day.</p>
      <% } %>
      <div class="field-row"><div class="field"><label for="f-name">Name</label><input id="f-name" name="name" autocomplete="name" required /></div>
      <div class="field"><label for="f-email">Email</label><input id="f-email" name="email" type="email" autocomplete="email" required /></div></div>
      <div class="field-row"><div class="field"><label for="f-org">Organisation</label><input id="f-org" name="organisation" autocomplete="organization" /></div>
      <div class="field"><label for="f-role">I'm getting in touch as</label>
        <select id="f-role" name="role">
          <option value="client">A client with a project</option>
          <option value="investor">An investor or funder</option>
          <option value="recruiter">A recruiter or employer</option>
          <option value="partner">A partner or contractor</option>
          <option value="research">A university or researcher</option>
          <option value="other">Something else</option>
        </select>
      </div></div>
      <div class="field"><label for="f-msg">Message</label><textarea id="f-msg" name="message" rows="5" required></textarea></div>
      <div class="hp" aria-hidden="true"><label for="f-web">Website</label><input id="f-web" name="website" tabindex="-1" autocomplete="off" /></div>
      <button class="btn btn-primary" type="submit">Send Message</button>
    </form>
  </div>
</section>
