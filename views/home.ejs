<%
var sectorIcons = { energy: 'bolt', video: 'camera', fleet: 'truck', city: 'city', agri: 'leaf' };
function ph(label, cls) {
  // Placeholder until Fahim's project photos arrive
  return '<div class="ph ' + (cls || '') + '" role="img" aria-label="' + label + '"><span>Photo: ' + label + '</span></div>';
}
%>

<!-- 1. Hero -->
<section class="hero">
  <div class="hero-media" aria-hidden="true"><span class="ph-note">Placeholder – wide hero photo of a real deployment</span></div>
  <div class="wrap hero-content">
    <p class="eyebrow">SciFlair · Bristol, UK</p>
    <h1>Connected Systems Engineering</h1>
    <p class="hero-sectors">IoT · Energy · Video · Automation · AI</p>
    <p class="hero-lede">We design, build and support complete connected systems – hardware, embedded firmware, cloud platforms and apps – from the first requirement to years in the field.</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="#projects">See Our Projects</a>
      <a class="btn btn-outline" href="#contact">Talk To Us</a>
    </div>
  </div>
</section>

<!-- 2. Proof strip -->
<section class="proof" aria-label="SciFlair in numbers">
  <div class="wrap proof-grid">
    <% site.proof.forEach(function (p) { %>
      <div class="proof-item">
        <span class="proof-value"><%= p.value %></span>
        <span class="proof-label"><%= p.label %></span>
      </div>
    <% }) %>
  </div>
</section>

<!-- 2b. Routes for each audience -->
<section class="routes" aria-label="Work with SciFlair">
  <div class="wrap routes-grid">
    <% site.audiences.forEach(function (a) { %>
      <a class="route" href="<%= a.href %>">
        <span class="route-who"><%= a.who %></span>
        <h2 class="route-title"><%= a.title %></h2>
        <p><%= a.text %></p>
        <span class="link"><%= a.cta %> <%- include('partials/icon', { name: 'arrow' }) %></span>
      </a>
    <% }) %>
  </div>
</section>

<!-- 3. What we build -->
<section class="section" id="what-we-build">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">What We Build</p>
      <h2>Five Sectors, One Engineering Team</h2>
      <p>The same team designs the electronics, writes the firmware, runs the cloud and builds the apps, so every system works as one.</p>
    </div>
    <div class="sector-grid">
      <% site.sectorTiles.forEach(function (key, i) { var s = site.sectors[key]; %>
        <a class="sector-tile<%= i === 0 ? ' sector-tile--wide' : '' %>" href="#projects">
          <%- ph(s.name, 'ph-tile') %>
          <div class="sector-body">
            <span class="sector-icon"><%- include('partials/icon', { name: sectorIcons[key] }) %></span>
            <h3><%= s.name %></h3>
            <p><%= s.blurb %></p>
          </div>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<!-- 4. Featured projects -->
<section class="section section-grey" id="projects">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Featured Projects</p>
      <h2>Systems Running in the Field</h2>
    </div>
    <div class="project-grid">
      <% site.featured.forEach(function (p) { var s = site.sectors[p.sector]; %>
        <article class="project-card">
          <div class="project-media">
            <% if (p.photo) { %>
              <img src="<%= p.photo %>" alt="<%= p.photoAlt %>" width="500" height="400" loading="lazy" />
            <% } else { %>
              <%- ph(p.title, 'ph-card') %>
            <% } %>
            <% if (p.result) { %><span class="project-result"><%= p.result %></span><% } %>
          </div>
          <div class="project-body">
            <span class="tag tag-<%= s.tag %>"><%= s.name %></span>
            <h3><% if (p.need) { %><a class="card-link" href="/projects/<%= p.slug %>"><%= p.title %></a><% } else { %><%= p.title %><% } %></h3>
            <p><%= p.headline %></p>
            <% if (p.client) { %><p class="project-meta"><%= p.client %><%= p.region ? ' · ' + p.region : '' %></p><% } %>
            <% if (p.need) { %><span class="link card-more">Read the project <%- include('partials/icon', { name: 'arrow' }) %></span><% } %>
          </div>
        </article>
      <% }) %>
    </div>
    <div class="center">
      <!-- Phase 2: link to the full gallery at /projects -->
      <a class="btn btn-dark" href="#contact">Discuss a Similar Project <%- include('partials/icon', { name: 'arrow' }) %></a>
    </div>
  </div>
</section>

<!-- 5. How we work -->
<section class="section section-navy">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">How We Work</p>
      <h2>The Whole System Life Cycle, Under One Roof</h2>
      <p>We follow INCOSE systems engineering practice (ISO/IEC/IEEE 15288) and run projects in PRINCE2 management stages, so every stage ends at a decision gate where you review progress, risk and the business case before committing to the next.</p>
    </div>
    <ol class="steps">
      <% site.steps.forEach(function (st, i) { %>
        <li class="step">
          <span class="step-num"><%= ('0' + (i + 1)) %></span>
          <h3><%= st.title %></h3>
          <p><%= st.text %></p>
        </li>
      <% }) %>
    </ol>
  </div>
</section>

<!-- 6. Our platforms -->
<section class="section" id="platforms">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Our Platforms</p>
      <h2>Products We Build On</h2>
    </div>
    <div class="platform-grid">
      <article class="platform">
        <%- ph('Axino modules', 'ph-platform') %>
        <div class="platform-body">
          <h3>Axino</h3>
          <p>Our IoT platform: swappable WiFi, GSM, Ethernet, LoRa and Mesh modules with secure cloud management, so products go from prototype to deployment quickly.</p>
          <a class="link" href="https://www.axino.co/">Visit axino.co <%- include('partials/icon', { name: 'arrow' }) %></a>
        </div>
      </article>
      <article class="platform">
        <div class="platform-shot"><img src="/images/placeholder/itrack-screen.webp" alt="iTrack fleet tracking dashboard showing vehicles on a map" width="960" height="484" loading="lazy" /></div>
        <div class="platform-body">
          <h3>iTrack</h3>
          <p>GPS fleet tracking built on our own S100 tracker, with electronic locks and geofencing for fuel-tanker anti-theft.</p>
          <a class="link" href="https://itrack.uk/">Visit itrack.uk <%- include('partials/icon', { name: 'arrow' }) %></a>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- 7. Research & leadership -->
<section class="section section-grey" id="research">
  <div class="wrap founder">
    <div class="founder-photo"><%- ph('Founder', 'ph-founder') %></div>
    <div class="founder-body">
      <p class="eyebrow">Research &amp; Leadership</p>
      <h2>Led by an Engineer</h2>
      <p class="founder-name">Dr M Fahim Tariq, Founder &amp; Director</p>
      <p>Fahim founded SciFlair in 2014 and has led engineering programmes for more than 25 years, including a £10M+ command-and-control vehicle programme at XAD Communications. He holds a PhD in adaptive modem design from the University of Bristol.</p>
      <ul class="facts">
        <li><strong>17</strong> peer-reviewed papers, 380+ citations</li>
        <li><strong>2</strong> UWE PhDs supervised, graduated 2026</li>
        <li><strong>KTP</strong> partnership on cloud video analytics</li>
        <li><strong>Up to 17</strong> engineers in the team</li>
        <li><strong>22</strong> engineers built up at XAD, funded by contract revenue</li>
        <li><strong>£5M+</strong> follow-on contract won on the flagship programme</li>
      </ul>
      <a class="btn btn-dark" href="https://www.linkedin.com/company/sciflair-limited/"><%- include('partials/icon', { name: 'linkedin' }) %> Connect on LinkedIn</a>
    </div>
  </div>
</section>

<!-- 8. Contact -->
<section class="section section-navy" id="contact">
  <div class="wrap contact">
    <div class="contact-info">
      <p class="eyebrow">Contact</p>
      <h2>Tell Us About Your Project</h2>
      <p>From a prototype to a full system rollout. We reply within one working day.</p>
      <ul class="contact-list">
        <li><%- include('partials/icon', { name: 'phone' }) %><a href="tel:+441173137585">+44 (0)117 313 7585</a></li>
        <li><%- include('partials/icon', { name: 'mail' }) %><a href="mailto:info@sciflair.com">info@sciflair.com</a></li>
        <li><%- include('partials/icon', { name: 'pin' }) %><a href="https://www.google.com/maps/search/?api=1&amp;query=Unit+18+Apex+Court+Bradley+Stoke+BS32+4JT">Unit 18, Apex Court, Woodlands,<br>Bradley Stoke, Bristol BS32 4JT</a></li>
      </ul>
    </div>
    <form class="contact-form" method="post" action="/contact">
      <% if (contactStatus === 'invalid') { %>
        <p class="form-msg form-msg--warn" role="alert">Please add your name, a valid email address and a message.</p>
      <% } else if (contactStatus === 'not-connected') { %>
        <p class="form-msg form-msg--warn" role="alert">Thank you. Our form is being connected – please also email <a href="mailto:info@sciflair.com">info@sciflair.com</a> so we don't miss you.</p>
      <% } else if (contactStatus === 'sent') { %>
        <p class="form-msg" role="status">Thank you – we'll be in touch within one working day.</p>
      <% } %>
      <div class="field"><label for="f-name">Name</label><input id="f-name" name="name" autocomplete="name" required /></div>
      <div class="field"><label for="f-email">Email</label><input id="f-email" name="email" type="email" autocomplete="email" required /></div>
      <div class="field"><label for="f-org">Organisation</label><input id="f-org" name="organisation" autocomplete="organization" /></div>
      <div class="field"><label for="f-role">I'm getting in touch as</label>
        <select id="f-role" name="role">
          <option value="client">A client with a project</option>
          <option value="investor">An investor or funder</option>
          <option value="recruiter">A recruiter or employer</option>
          <option value="partner">A partner or contractor</option>
          <option value="research">A university or researcher</option>
        </select>
      </div>
      <div class="field"><label for="f-msg">Message</label><textarea id="f-msg" name="message" rows="5" required></textarea></div>
      <div class="hp" aria-hidden="true"><label for="f-web">Website</label><input id="f-web" name="website" tabindex="-1" autocomplete="off" /></div>
      <button class="btn btn-primary" type="submit">Send Message</button>
    </form>
  </div>
</section>
