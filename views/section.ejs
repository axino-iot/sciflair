<section class="sec-hero">
  <div class="wrap">
    <p class="eyebrow"><%= sec.who %></p>
    <h1><%= sec.title %></h1>
    <p class="sec-intro"><%= sec.intro %></p>
    <div class="sec-ask">
      <p><%= sec.ask %></p>
      <a class="btn btn-primary" href="/#contact"><%= sec.cta %></a>
    </div>
  </div>
</section>

<section class="section section-grey">
  <div class="wrap">
    <div class="project-grid<%= items.length === 4 ? ' grid-4' : '' %>">
      <% items.forEach(function (p) { %>
        <div class="grid-item" data-sector="<%= p.sector %>" data-ai="<%= p.ai ? 1 : 0 %>"><%- include('partials/card', { p: p, site: site }) %></div>
      <% }) %>
    </div>
  </div>
</section>

<% var order = Object.keys(site.sections).map(function (k) { return site.sections[k]; });
   var nx = order[(order.indexOf(sec) + 1) % order.length]; %>
<section class="sec-next">
  <div class="wrap sec-next-inner">
    <div>
      <p class="eyebrow"><%= nx.who %></p>
      <h2><%= nx.title %></h2>
      <p><%= nx.intro %></p>
    </div>
    <a class="btn btn-primary btn-lg" href="/<%= nx.path %>">See Our <%= nx.path === 'research' ? 'R&D' : nx.title %> <%- include('partials/icon', { name: 'arrow' }) %></a>
  </div>
</section>
