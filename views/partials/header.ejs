<header class="site-header" id="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label="SciFlair home">
      <img src="/images/sciflair-cs.svg" alt="SciFlair – Connected Systems" width="200" height="56" />
    </a>
    <button class="nav-toggle" id="nav-toggle" type="button" aria-controls="site-nav" aria-expanded="false" aria-label="Menu">
      <%- include('icon', { name: 'menu' }) %>
    </button>
    <nav class="site-nav" id="site-nav" aria-label="Main">
<% var cp = (typeof currentPath === 'string') ? currentPath : '';
   function cur(base) { return (cp === base || cp.indexOf(base + '/') === 0) ? ' aria-current="page"' : ''; } %>
      <a class="nav-home" href="/"<%- cp === '/' ? ' aria-current="page"' : '' %>>Home</a>
      <a href="/projects"<%- cur('/projects') %>>Projects</a>
      <a href="/products"<%- cur('/products') %>>Products</a>
      <a href="/research"<%- cur('/research') %>>R&amp;D</a>
      <a href="/#research">About</a>
      <a class="btn btn-primary btn-sm" href="/#contact">Talk To Us</a>
    </nav>
  </div>
</header>
